# FxmeNet's version, from one place: the latest git tag vX.Y.Z (included by
# the root CMakeLists.txt before project()).
#
#   - FXMENET_VERSION, when given (-DFXMENET_VERSION=0.2.0: a source archive
#     without git, or CI), wins;
#   - otherwise `git describe` gives the latest tag v* reachable from HEAD;
#   - otherwise 0.0.0.
#
# Sets FXMENET_VERSION (the full text, "0.2.0" or "0.3.0-beta") and
# FXMENET_VERSION_NUMERIC ("0.2.0", what project() and the plugin formats
# take), and writes FxmeNet/Version.h (FXMENET_VERSION as a string) into the
# build folder, included by every target. Configuring again happens by
# itself when a tag is added or HEAD moves.

set(FXMENET_VERSION "" CACHE STRING "FxmeNet's version; empty: the latest git tag vX.Y.Z")

set(_fxmenet_version "${FXMENET_VERSION}")
if(_fxmenet_version STREQUAL "")
    find_package(Git QUIET)
    if(GIT_FOUND AND EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/.git")
        execute_process(
            COMMAND "${GIT_EXECUTABLE}" describe --tags --match "v[0-9]*" --abbrev=0
            WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}"
            OUTPUT_VARIABLE _fxmenet_tag
            OUTPUT_STRIP_TRAILING_WHITESPACE
            ERROR_QUIET
            RESULT_VARIABLE _fxmenet_git_result)
        if(_fxmenet_git_result EQUAL 0)
            string(REGEX REPLACE "^v" "" _fxmenet_version "${_fxmenet_tag}")
        endif()

        # A new tag, a commit, a checkout: configure again.
        foreach(_fxmenet_ref HEAD packed-refs refs/tags)
            if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/.git/${_fxmenet_ref}")
                set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
                             "${CMAKE_CURRENT_SOURCE_DIR}/.git/${_fxmenet_ref}")
            endif()
        endforeach()
    endif()
endif()
string(REGEX REPLACE "^v" "" _fxmenet_version "${_fxmenet_version}")
if(_fxmenet_version STREQUAL "")
    set(_fxmenet_version "0.0.0")
endif()

string(REGEX MATCH "^[0-9]+\\.[0-9]+\\.[0-9]+" FXMENET_VERSION_NUMERIC "${_fxmenet_version}")
if(FXMENET_VERSION_NUMERIC STREQUAL "")
    message(FATAL_ERROR "FxmeNet version '${_fxmenet_version}' does not start with X.Y.Z")
endif()
# A plain variable over the cache entry, which stays empty (or as given), so
# that the next configuration asks git again.
set(FXMENET_VERSION "${_fxmenet_version}")
message(STATUS "FxmeNet version ${FXMENET_VERSION}")

file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/generated/FxmeNet/Version.h" CONTENT
"// Generated by cmake/Version.cmake: do not edit.
#pragma once
#define FXMENET_VERSION \"@FXMENET_VERSION@\"
" @ONLY)
include_directories("${CMAKE_BINARY_DIR}/generated")
